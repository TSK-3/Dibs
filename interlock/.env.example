# ── AI Studio / Gemini ──────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Identity service (server/) ──────────────────────────────────────────────
# Public base URL of the auth service. Provider redirect URIs are derived from
# it, so it must be a URL the browser can reach.
AUTH_PUBLIC_URL="http://localhost:8787"

# Where the browser is sent back after a successful sign-in: this Vite app.
APP_URL="http://localhost:3000"

# Session signing key (HMAC-SHA256). REQUIRED in production, min 32 chars:
#   openssl rand -hex 32
# Left blank in development, the service generates .data/session-secret once.
SESSION_SECRET=""

# ── Google (Gmail / Google Workspace) ──────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI, exactly:
#   http://localhost:8787/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── GitHub ─────────────────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App.
# Authorization callback URL, exactly:
#   http://localhost:8787/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Optional tuning (all have safe defaults) ───────────────────────────────
# AUTH_PORT=8787                 # identity service port (dev proxy target)
# AUTH_HOST=0.0.0.0
# SESSION_TTL_MS=43200000        # 12 h sessions
# STATE_TTL_MS=600000            # OAuth round-trip budget (10 min)
# SESSION_COOKIE_NAME=il_session
# COOKIE_SECURE=1                # force Secure cookies (required over https)
# TRUST_PROXY=1                  # behind a load balancer, for an honest req.ip
# AUTH_RATE_MAX=120              # auth requests per IP per window
# AUTH_RATE_WINDOW_MS=300000
# AUTH_SERVE_STATIC=off          # API-only mode (do not serve dist/)
# LOG_LEVEL=info
# LOG_JSON=1
#
# There is no demo/guest sign-in: a provider without credentials is disabled in
# the UI and its /start route fails closed with `<provider>_not_configured`.

