{
  "name": "live-interrupt-backend",
  "version": "1.0.0",
  "description": "Team Insomniacs — iQOO Hackathon 2026. Live interrupt backend: WebSocket server, scope-overlap matcher, snapshot-persisted in-memory store, and MCP tool wrapper.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.17.0"
  },
