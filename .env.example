# Interlock — root WebSocket backend configuration
# Copy to .env.local (git-ignored) and adjust. All variables are optional;
# the service runs with sensible defaults out of the box.

# HTTP and WebSocket bind address/port.
# PORT=8080
# HOST=0.0.0.0

# Closed scope enum (comma-separated). Leave unset to use the built-in list,
# or set SCOPES_OPEN=1 to accept arbitrary file-path scopes (the web console's
# dev:full script sets this automatically).
# SCOPES=auth,payment,ui,api,db,infra
# SCOPES_OPEN=1

# Path to a JSON array or { "scopes": [] } file defining the scope enum.
# SCOPES_FILE=

# Active-claim snapshot location (crash-safe restart recovery).
# SNAPSHOT_PATH=snapshots/claims-snapshot.json

# Optional active-claim expiration period in milliseconds (0 = never expires).
# CLAIM_TTL_MS=0

# Shared token required during connection when configured (use with wss:// in
# untrusted networks).
# AUTH_TOKEN=

# Per-connection rate limiting.
# RATE_CAPACITY=30
# RATE_REFILL_PER_SEC=10

# Maximum concurrent WebSocket connections.
# MAX_CLIENTS=500

# Socket health-check interval in milliseconds.
# PING_INTERVAL_MS=30000

# Logging configuration (levels: trace|debug|info|warn|error).
# LOG_LEVEL=info
# LOG_JSON=1

